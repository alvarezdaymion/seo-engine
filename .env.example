# Copy to .env (never commit it) or export these in the environment your scheduler uses.
# Each connector stays off until it is configured. Give each one the narrowest access it allows.

# Google Search Console, read-only: a service-account JSON key file. Add the service account's
# email address to the property in Search Console as a Restricted user.
GSC_SERVICE_ACCOUNT_FILE=
# Or an OAuth access token with the webmasters.readonly scope. It expires after an hour.
GSC_ACCESS_TOKEN=

# GitHub review ([review] enabled = true): a fine-grained token for the one repo, with
# Contents read and write, Pull requests read and write, and Checks read.
GITHUB_TOKEN=

# Shopify Pages ([publish] target = "shopify"): your-store.myshopify.com and a custom app's
# Admin API access token with read_content and write_content only.
SHOPIFY_STORE=
SHOPIFY_ADMIN_TOKEN=

# Weekly report delivery ([report] send = "webhook"): an https incoming-webhook URL.
SEO_ENGINE_REPORT_WEBHOOK=

# Optional model draft ([draft] mode = "model", `uv sync --extra llm`).
ANTHROPIC_API_KEY=
